{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-plugin-myteam/schema/team-config.schema.json",
  "title": "myteam team.config.json",
  "description": "myteam 行为配置（FR-9.1）。三层合并：内置默认（DEFAULT_CONFIG）← 项目 config/team.config.json ← 团队 state/teams/<teamId>/team.config.json。数组整条替换（K5），对象段落按子键合并，未知键告警忽略；任一层的终态覆盖或结构校验失败 → 该层整层忽略（拒绝式回退），其余层保留；最后 limits 按 patch 硬上限钳制。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "taskPlanning": {
      "enum": ["captain", "template"],
      "default": "captain",
      "description": "DAG 来源二选一（FR-1.3 / CHG-173）。captain = 队长按目标推导任务组（默认）；template = submit_plan 未显式给任务时按 pipeline.stages 生成内置固定流水线模板任务组（线性链，每阶段一任务；AC 与交付物路径为占位，approve 前由队长编辑）。唯一的顶层标量字段：合并走整条替换。"
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "description": "看板列与状态归并。columnMapping 的归并结果必须覆盖全部终态（done / failed / blocked / cancelled），否则该层配置非法。",
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "default": ["backlog", "ready", "running", "gates", "done"],
          "description": "列顺序（左 → 右）"
        },
        "columnMapping": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "default": {
            "running": ["in_progress", "re-scoping"],
            "gates": ["gate:review", "gate:verify", "gate:archive"],
            "done": ["done"],
            "backlog": ["failed", "blocked", "cancelled"]
          },
          "description": "列名 → 归并状态列表；必须覆盖全部终态"
        },
        "cardFields": {
          "type": "array",
          "items": { "enum": ["assignee", "deps", "gateState", "tokens"] },
          "default": ["assignee", "deps", "gateState", "tokens"],
          "description": "看板卡展示字段"
        },
        "dragRules": {
          "enum": ["state-machine"],
          "default": "state-machine",
          "description": "拖拽规则；v1 只有状态机（非法流转抖动 + 弹回）"
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "description": "蛇形泳道图（design-v2/p-lanes.html）",
      "properties": {
        "swimlaneBy": { "enum": ["stage", "member", "priority"], "default": "stage" },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "default": ["plan", "dev", "gates", "integrate"]
        },
        "layout": { "enum": ["serpentine", "linear"], "default": "serpentine" }
      }
    },
    "dag": {
      "type": "object",
      "additionalProperties": false,
      "description": "依赖图（design-v2/p-dag.html）",
      "properties": {
        "showModel": { "type": "boolean", "default": true },
        "collapseGroups": { "type": "boolean", "default": true },
        "direction": { "enum": ["LR", "TB"], "default": "LR" }
      }
    },
    "views": {
      "type": "object",
      "additionalProperties": false,
      "description": "视图条与默认视图",
      "properties": {
        "default": { "enum": ["board", "swimlane", "dag", "roster"], "default": "board" },
        "tabs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["board", "swimlane", "dag", "roster"] },
          "default": ["board", "swimlane", "dag", "roster"]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "规模上限。maxMembers / memberMaxDepth / maxChildren 是 patch 硬上限：config 超过即钳制并告警（更严格者胜，R12）。",
      "properties": {
        "maxMembers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 6,
          "description": "团队最多成员数（硬上限 6，PATCH_CEILINGS）"
        },
        "memberMaxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 1,
          "description": "成员派生深度（FR-32 / CHG-187：默认 1 = 允许一层子成员，硬上限 2；老团队配置里已有的 0 原样保留）"
        },
        "maxChildren": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 3,
          "description": "单个成员最多直接子成员数（FR-32 / CHG-187：默认 3，硬上限 5）"
        },
        "maxTasks": { "type": "integer", "minimum": 1, "default": 20 }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "description": "门禁（命令验证）默认值",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "commandTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000, "default": 120000 }
      }
    },
    "taskTypes": {
      "type": "object",
      "description": "任务类型 → 门禁链（create_task 时按 taskType 展开；显式 gateChain 优先）",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gateChain"],
        "properties": {
          "gateChain": {
            "type": "array",
            "items": { "enum": ["review", "verify", "archive"] }
          }
        }
      },
      "default": {
        "default": { "gateChain": ["review", "archive"] },
        "dev": { "gateChain": ["review", "verify", "archive"] }
      }
    },
    "clarify": {
      "type": "object",
      "additionalProperties": false,
      "description": "澄清轮次上限",
      "properties": {
        "maxRounds": { "type": "integer", "minimum": 0, "default": 3 }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "description": "记忆审计（CHG-19 / ADR-009）",
      "properties": {
        "evidenceRequired": { "type": "boolean", "default": true }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "description": "scope 完成审计（CHG-87 / FR-5.4）：越界只留痕不阻断",
      "properties": {
        "writeScopes": { "type": "boolean", "default": true }
      }
    }
  },
  "definitions": {
    "roleDefinition": {
      "$comment": "角色定义（C5 / CHG-74 / CHG-89）：落 roles/<id>.json；R13 运行时不认非项目库，但 schema 覆盖全部来源",
      "type": "object",
      "required": ["id", "name", "description", "systemPrompt", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "isCaptain": { "type": "boolean", "description": "预设必含且仅含一个队长；内置仅 captain 带此标记" },
        "systemPrompt": { "type": "string" },
        "toolPolicy": {
          "type": "object",
          "additionalProperties": false,
          "description": "C5：allow 只能收窄不能扩权（成员 setup 时按 allow 生成 restrict 掩码）",
          "properties": {
            "allow": { "type": "array", "items": { "type": "string" } },
            "deny": { "type": "array", "items": { "type": "string" } }
          }
        },
        "skills": { "type": "array", "items": { "type": "string" } },
        "mcpAllowlist": { "type": "array", "items": { "type": "string" } },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 }
          }
        },
        "interestWords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "兴趣词（FR-20）：软信号（派单理由 / 认领排序），不是权限"
        },
        "origin": { "type": "string", "pattern": "^(builtin|global|plugin):[a-z0-9-]+$", "description": "fork 来源标记（内置/全局/插件 → 副本时写入）" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "presetMember": {
      "type": "object",
      "required": ["roleId"],
      "additionalProperties": false,
      "properties": {
        "roleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "instanceName": { "type": "string", "minLength": 1 },
        "skills": { "type": "array", "items": { "type": "string" } },
        "mcpAllowlist": { "type": "array", "items": { "type": "string" } }
      }
    },
    "presetDefinition": {
      "$comment": "团队模板（CHG-55 / CHG-91 插件贡献契约 v1）：建团时把显式声明的 board/pipeline/gates/taskTypes 原子写进团队级 team.config.json",
      "type": "object",
      "required": ["id", "name", "members"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "members": { "type": "array", "items": { "$ref": "#/definitions/presetMember" } },
        "board": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "columnMapping": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
          }
        },
        "pipeline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "swimlaneBy": { "enum": ["stage", "member", "priority"] },
            "stages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "layout": { "enum": ["serpentine", "linear"] }
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "commandTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 }
          }
        },
        "taskTypes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gateChain"],
            "properties": { "gateChain": { "type": "array", "items": { "enum": ["review", "verify", "archive"] } } }
          }
        },
        "version": { "type": "integer", "minimum": 1 },
        "namespace": { "type": "string", "minLength": 1, "description": "插件贡献的面板分组名（缺省 = 插件 id 第一段）" },
        "charter": { "type": "string", "description": "团队章程 markdown（FR-18）" }
      }
    }
  }
}
