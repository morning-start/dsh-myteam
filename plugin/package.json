{
  "name": "dsh-plugin-myteam",
  "version": "2.0.0-alpha.1",
  "description": "myteam v2 —— DSH 内的项目级多智能体团队运行时：定义资产、项目事件真源、任务 DAG、门禁与统一投影。",
  "type": "module",
  "main": "./lib/composition/host.mjs",
  "exports": {
    ".": "./lib/composition/host.mjs",
    "./host": "./lib/composition/host.mjs",
    "./member": "./lib/composition/member.mjs",
    "./panel": "./lib/composition/panel.mjs",
    "./commands": "./lib/composition/human-command.mjs",
    "./icon": "./icon.svg",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22.18",
    "dsh": ">=0.2.1-rc.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "src",
    "client",
    "scripts",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "scripts": {
    "build:lib": "node scripts/build-lib.mjs",
    "test": "node --test test/*.test.ts",
    "verify": "node ../tools/verify.mjs",
    "check:arch": "node ../tools/check-architecture.mjs"
  },
  "license": "MIT"
}
