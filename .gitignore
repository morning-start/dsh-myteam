# >>> dsh-plugin-myteam managed block >>>
.team-workplace/state/
.team-workplace/archive/
# <<< dsh-plugin-myteam managed block <<<
#
# 上方托管块由插件幂等维护（plugin/src/host-workspace.ts:30-69），**请勿手改**；
# 其余规则是人工维护层，插件不读不写。

# ────────────────────────────────────────────────────────────────
# 依赖与构建产物
# ────────────────────────────────────────────────────────────────
node_modules/
#
# 注意：plugin/lib/ 是构建产物，但**随包分发**（package.json 的 main 指向它），
# 且 t42 用 lib/build-manifest.json 守 src↔lib 一致 —— **必须入库，不要忽略**。
# 改 plugin/src 后忘记 `npm run bundle` 会让仓库里得到两份不一致的真相（R38）。

# ────────────────────────────────────────────────────────────────
# 运行时数据（队长会话首开 / 实弹 boot 生成，不入库）
# ────────────────────────────────────────────────────────────────
.team-workplace/

# ────────────────────────────────────────────────────────────────
# 本地参考资产（竞品源码 / 宿主源码快照 / 测试证据，约 283 MB）
# 仅本机调研用，删除不影响构建与测试；见 refs/README.md
# ────────────────────────────────────────────────────────────────
refs/

# ────────────────────────────────────────────────────────────────
# 本地取证与临时产物（一次性，不入库）
#   .tmp/asar-current/  app.asar 解包（tools/extract-asar.mjs 产出）
#   .tmp/notes/         调研笔记（docs/15 的取证底稿）
# ────────────────────────────────────────────────────────────────
.tmp/
tmp/
*.tmp

# ────────────────────────────────────────────────────────────────
# 本地 UI 调试产物（CDP 截图 / 播种的演示工作区 / 场景脚本）
# ────────────────────────────────────────────────────────────────
.debug/

# ────────────────────────────────────────────────────────────────
# 日志
# ────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ────────────────────────────────────────────────────────────────
# 测试与覆盖率
# ────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/

